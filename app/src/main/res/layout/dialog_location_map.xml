<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <TextView style="@style/Muted" android:text="@string/map_hint" />
        <TextView android:id="@+id/map_status" style="@style/Muted" android:text="@string/map_loading" android:accessibilityLiveRegion="polite" />
        <FrameLayout android:layout_width="match_parent" android:layout_height="280dp">
            <WebView android:id="@+id/location_web_map" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@string/map_title" />
        </FrameLayout>
        <TextView style="@style/Body" android:text="@string/map_latitude" android:labelFor="@+id/map_latitude" />
        <EditText android:id="@id/map_latitude" style="@style/Field" android:inputType="numberDecimal|numberSigned" android:importantForAutofill="no" android:layout_height="wrap_content" android:minHeight="56dp" android:maxLength="20" />
        <TextView style="@style/Body" android:text="@string/map_longitude" android:labelFor="@+id/map_longitude" />
        <EditText android:id="@id/map_longitude" style="@style/Field" android:inputType="numberDecimal|numberSigned" android:importantForAutofill="no" android:layout_height="wrap_content" android:minHeight="56dp" android:maxLength="20" />
        <TextView style="@style/Muted" android:autoLink="web" android:text="https://www.openstreetmap.org/copyright" />
    </LinearLayout>
</ScrollView>