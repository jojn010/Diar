    </LinearLayout>
  </ScrollView>
  <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:background="@color/white" android:gravity="center">
    <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:text="@string/screen_discover_text_17" android:textSize="11sp" android:textColor="@color/teal" android:tag="home" android:onClick="navigate" />
    <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:text="@string/screen_discover_text_18" android:textSize="11sp" android:textColor="@color/teal" android:tag="favorites" android:onClick="navigate" />
