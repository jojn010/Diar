    <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:text="@string/screen_discover_text_20" android:textSize="11sp" android:textColor="@color/teal" android:tag="chat" android:onClick="navigate" />
    <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:text="@string/screen_discover_text_21" android:textSize="11sp" android:textColor="@color/teal" android:tag="account" android:onClick="navigate" />
