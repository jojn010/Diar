      <TextView style="@style/Subtitle" android:text="@string/screen_discover_text_6" />
      <com.google.android.material.button.MaterialButton style="@style/Action" android:text="@string/screen_discover_text_7" android:tag="search" android:onClick="navigate" />
      <com.google.android.material.button.MaterialButton style="@style/Action" android:text="@string/screen_discover_text_8" android:tag="search" android:onClick="navigate" />
      <com.google.android.material.button.MaterialButton style="@style/Action" android:text="@string/screen_discover_text_9" android:tag="map" android:onClick="navigate" />
