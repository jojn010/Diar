<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/canvas">
    <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:gravity="center_vertical" android:paddingHorizontal="16dp">
        <ImageButton android:layout_width="48dp" android:layout_height="48dp" android:gravity="center" android:contentDescription="@string/screen_favorites_contentdescription_2" android:onClick="goBack" android:src="@drawable/ic_back" android:background="@drawable/pill" android:padding="12dp" />
        <TextView style="@style/Subtitle" android:text="@string/screen_favorites_text_3" android:gravity="center" android:layout_weight="1" android:layout_width="0dp" android:layout_marginBottom="0dp" android:layout_marginTop="0dp" android:textSize="16sp" />
        <Space android:layout_width="48dp" android:layout_height="1dp" />
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:scrollbars="none">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:paddingBottom="28dp">
            <TextView style="@style/Title" android:text="@string/screen_favorites_text_7" />
            <LinearLayout android:id="@+id/saved_items" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <include layout="@layout/item_property_card" android:id="@+id/sample_card_favorites_0" />
            </LinearLayout>
            <TextView style="@style/Muted" android:text="@string/screen_favorites_text_14" />
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="70dp" android:background="@drawable/nav_background" android:gravity="center" android:layout_marginHorizontal="16dp" android:layout_marginBottom="8dp" android:padding="6dp" android:elevation="3dp">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:text="@string/nav_home" android:textSize="11sp" android:textColor="@color/teal" android:tag="home" android:onClick="navigate" android:drawableTop="@drawable/ic_home" android:drawablePadding="3dp" android:paddingTop="5dp" android:paddingBottom="3dp" />
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:text="@string/nav_saved" android:textSize="11sp" android:textColor="@color/teal" android:tag="favorites" android:onClick="navigate" android:drawableTop="@drawable/ic_heart" android:drawablePadding="3dp" android:paddingTop="5dp" android:paddingBottom="3dp" android:background="@drawable/pill" android:textStyle="bold" />
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:text="@string/nav_discover" android:textSize="11sp" android:textColor="@color/teal" android:tag="discover" android:onClick="navigate" android:drawableTop="@drawable/ic_search" android:drawablePadding="3dp" android:paddingTop="5dp" android:paddingBottom="3dp" />
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:text="@string/nav_inbox" android:textSize="11sp" android:textColor="@color/teal" android:tag="chat" android:onClick="navigate" android:drawableTop="@drawable/ic_chat" android:drawablePadding="3dp" android:paddingTop="5dp" android:paddingBottom="3dp" />
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:text="@string/nav_account" android:textSize="11sp" android:textColor="@color/teal" android:tag="account" android:onClick="navigate" android:drawableTop="@drawable/ic_account" android:drawablePadding="3dp" android:paddingTop="5dp" android:paddingBottom="3dp" />
    </LinearLayout>
</LinearLayout>