<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/canvas">
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:scrollbars="none">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:paddingBottom="28dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical" android:layout_marginBottom="16dp">
                <TextView style="@style/Subtitle" android:text="@string/home_wordmark" android:layout_width="0dp" android:layout_weight="1" android:layout_marginTop="0dp" android:layout_marginBottom="0dp" android:textSize="25sp" />
                <ImageButton android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_bell" android:background="@drawable/surface_peach" android:padding="12dp" android:contentDescription="@string/notifications_button" android:tag="notifications" android:onClick="navigate" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/hero_teal" android:padding="24dp" android:layout_marginBottom="16dp">
                <TextView style="@style/Eyebrow" android:text="@string/home_eyebrow" android:textColor="@color/gold" />
                <TextView style="@style/Title" android:text="@string/home_headline" android:textColor="@color/white" android:textSize="34sp" />
                <TextView style="@style/Body" android:text="@string/home_description" android:textColor="@color/teal_light" />
                <com.google.android.material.button.MaterialButton style="@style/Outline" android:text="@string/home_search" android:tag="search" android:onClick="navigate" android:textSize="13sp" android:layout_height="wrap_content" android:minHeight="56dp" android:paddingTop="12dp" android:paddingBottom="12dp" />
            </LinearLayout>
            <com.google.android.material.button.MaterialButton style="@style/Gold" android:text="@string/sell_title" android:tag="sell" android:onClick="navigate" android:layout_height="wrap_content" android:minHeight="56dp" android:layout_marginBottom="16dp" />
            <com.google.android.material.button.MaterialButton style="@style/Outline" android:text="@string/view_my_homes" android:tag="my_listings" android:onClick="navigate" android:layout_height="wrap_content" android:minHeight="56dp" />
            <LinearLayout android:id="@+id/own_listings" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp">
                <com.google.android.material.button.MaterialButton style="@style/Action" android:text="@string/category_homes" android:tag="listings" android:onClick="navigate" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginEnd="6dp" android:textSize="12sp" android:minHeight="56dp" android:paddingTop="12dp" android:paddingBottom="12dp" />
                <com.google.android.material.button.MaterialButton style="@style/Warm" android:text="@string/category_villas" android:tag="listings" android:onClick="navigate" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginEnd="6dp" android:textSize="12sp" android:minHeight="56dp" android:paddingTop="12dp" android:paddingBottom="12dp" />
                <com.google.android.material.button.MaterialButton style="@style/Gold" android:text="@string/category_apartments" android:tag="listings" android:onClick="navigate" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginEnd="6dp" android:textSize="12sp" android:minHeight="56dp" android:paddingTop="12dp" android:paddingBottom="12dp" />
            </LinearLayout>
            <TextView style="@style/Subtitle" android:text="@string/home_popular" />
            <include layout="@layout/item_property_card" android:id="@+id/sample_card_home_0" />
            <include layout="@layout/item_property_card" android:id="@+id/sample_card_home_1" />
            <com.google.android.material.button.MaterialButton style="@style/Action" android:text="@string/screen_home_text_19" android:tag="listings" android:onClick="navigate" android:layout_height="wrap_content" android:minHeight="56dp" android:paddingTop="12dp" android:paddingBottom="12dp" />
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="70dp" android:background="@drawable/nav_background" android:gravity="center" android:layout_marginHorizontal="16dp" android:layout_marginBottom="8dp" android:padding="6dp" android:elevation="3dp">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:text="@string/nav_home" android:textSize="11sp" android:textColor="@color/teal" android:tag="home" android:onClick="navigate" android:drawableTop="@drawable/ic_home" android:drawablePadding="3dp" android:paddingTop="5dp" android:paddingBottom="3dp" android:background="@drawable/pill" android:textStyle="bold" />
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:text="@string/nav_saved" android:textSize="11sp" android:textColor="@color/teal" android:tag="favorites" android:onClick="navigate" android:drawableTop="@drawable/ic_heart" android:drawablePadding="3dp" android:paddingTop="5dp" android:paddingBottom="3dp" />
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:text="@string/nav_discover" android:textSize="11sp" android:textColor="@color/teal" android:tag="discover" android:onClick="navigate" android:drawableTop="@drawable/ic_search" android:drawablePadding="3dp" android:paddingTop="5dp" android:paddingBottom="3dp" />
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:text="@string/nav_inbox" android:textSize="11sp" android:textColor="@color/teal" android:tag="chat" android:onClick="navigate" android:drawableTop="@drawable/ic_chat" android:drawablePadding="3dp" android:paddingTop="5dp" android:paddingBottom="3dp" />
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:text="@string/nav_account" android:textSize="11sp" android:textColor="@color/teal" android:tag="account" android:onClick="navigate" android:drawableTop="@drawable/ic_account" android:drawablePadding="3dp" android:paddingTop="5dp" android:paddingBottom="3dp" />
    </LinearLayout>
</LinearLayout>