<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/canvas">
    <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:gravity="center_vertical" android:paddingHorizontal="16dp">
        <ImageButton android:layout_width="48dp" android:layout_height="48dp" android:gravity="center" android:contentDescription="@string/screen_listings_contentdescription_2" android:onClick="goBack" android:src="@drawable/ic_back" android:background="@drawable/pill" android:padding="12dp" />
        <TextView style="@style/Subtitle" android:text="@string/screen_listings_text_3" android:gravity="center" android:layout_weight="1" android:layout_width="0dp" android:layout_marginBottom="0dp" android:layout_marginTop="0dp" android:textSize="16sp" />
        <Space android:layout_width="48dp" android:layout_height="1dp" />
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:scrollbars="none">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:paddingBottom="28dp">
            <com.google.android.material.button.MaterialButton style="@style/Gold" android:text="@string/sell_title" android:tag="sell" android:onClick="navigate" android:layout_height="wrap_content" android:minHeight="56dp" android:layout_marginBottom="16dp" />
            <com.google.android.material.button.MaterialButton style="@style/Outline" android:text="@string/view_my_homes" android:tag="my_listings" android:onClick="navigate" android:layout_height="wrap_content" android:minHeight="56dp" />
            <LinearLayout android:id="@+id/own_listings" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
            <TextView style="@style/Title" android:text="@string/screen_listings_text_7" />
            <TextView style="@style/Muted" android:text="@string/screen_listings_text_8" />
            <com.google.android.material.button.MaterialButton style="@style/Secondary" android:text="@string/screen_listings_text_9" android:tag="search" android:onClick="navigate" app:icon="@drawable/ic_search" app:iconTint="@color/teal" app:iconGravity="textStart" android:layout_height="wrap_content" android:minHeight="56dp" android:paddingTop="12dp" android:paddingBottom="12dp" />
            <include layout="@layout/item_property_card" android:id="@+id/sample_card_listings_0" />
            <include layout="@layout/item_property_card" android:id="@+id/sample_card_listings_1" />
            <include layout="@layout/item_property_card" android:id="@+id/sample_card_listings_2" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>