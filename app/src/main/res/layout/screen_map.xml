        <TextView android:layout_width="110dp" android:layout_height="48dp" android:layout_marginTop="280dp" android:layout_marginStart="45dp" android:background="@drawable/card" android:text="@string/screen_map_text_14" android:textColor="@color/teal" android:gravity="center" android:tag="detail" android:onClick="navigate" />
