<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/white">
  <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:gravity="center_vertical" android:paddingHorizontal="16dp">
    <TextView android:layout_width="48dp" android:layout_height="48dp" android:text="@string/screen_payment_text_2" android:textSize="32sp" android:gravity="center" android:contentDescription="@string/screen_payment_contentdescription_2" android:onClick="goBack" />
    <TextView style="@style/Subtitle" android:text="@string/screen_payment_text_3" android:gravity="center" android:layout_weight="1" />
    <Space android:layout_width="48dp" android:layout_height="1dp" />
  </LinearLayout>
  <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
      <TextView style="@style/Title" android:text="@string/screen_payment_text_7" />
      <TextView style="@style/Muted" android:text="@string/screen_payment_text_8" />
      <TextView style="@style/Muted" android:text="@string/screen_payment_text_9" />
      <EditText android:id="@+id/card_name" style="@style/Field" android:hint="@string/screen_payment_hint_10" android:inputType="textPersonName" android:autofillHints="textPersonName" />
      <TextView style="@style/Muted" android:text="@string/screen_payment_text_11" />
      <EditText android:id="@+id/card_number" style="@style/Field" android:hint="@string/screen_payment_hint_12" android:inputType="number" android:autofillHints="number" />
      <TextView style="@style/Muted" android:text="@string/screen_payment_text_13" />
      <EditText android:id="@+id/card_expiry" style="@style/Field" android:hint="@string/screen_payment_hint_14" android:inputType="text" android:autofillHints="text" />
      <TextView style="@style/Muted" android:text="@string/screen_payment_text_15" />
      <EditText android:id="@+id/card_cvc" style="@style/Field" android:hint="@string/screen_payment_hint_16" android:inputType="numberPassword" android:autofillHints="numberPassword" />
      <TextView style="@style/Muted" android:text="@string/screen_payment_text_17" />
      <EditText android:id="@+id/country" style="@style/Field" android:hint="@string/screen_payment_hint_18" android:inputType="text" android:autofillHints="text" />
      <com.google.android.material.button.MaterialButton style="@style/Action" android:text="@string/screen_payment_text_19" android:id="@+id/payment_submit" />
    </LinearLayout>
  </ScrollView>
</LinearLayout>