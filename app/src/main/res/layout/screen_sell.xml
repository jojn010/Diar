<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/canvas">
    <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:gravity="center_vertical" android:paddingHorizontal="16dp">
        <ImageButton android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_back" android:background="@drawable/pill" android:padding="12dp" android:onClick="goBack" android:contentDescription="@string/screen_account_contentdescription_2" />
        <TextView style="@style/Subtitle" android:layout_width="0dp" android:layout_weight="1" android:gravity="center" android:text="@string/sell_title" />
    </LinearLayout>
    <TextView android:id="@+id/composer_step_label" style="@style/Eyebrow" android:paddingHorizontal="24dp" android:accessibilityLiveRegion="polite" android:text="@string/step_home" />
    <ProgressBar android:id="@+id/composer_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginHorizontal="24dp" android:layout_marginBottom="8dp" android:max="3" android:progress="1" android:progressTint="@color/teal" />
    <ScrollView android:id="@+id/composer_scroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
            <LinearLayout android:id="@+id/composer_home" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="visible">
                <TextView style="@style/Title" android:text="@string/composer_intro" />
                <TextView style="@style/Muted" android:text="@string/composer_caption" />
                <TextView style="@style/Body" android:text="@string/listing_name" android:labelFor="@+id/property_title" />
                <EditText style="@style/Field" android:id="@id/property_title" android:importantForAutofill="no" android:inputType="textCapSentences" android:maxLength="120" android:layout_height="wrap_content" android:minHeight="56dp" />
                <TextView style="@style/Subtitle" android:text="@string/purpose_title" />
                <RadioGroup android:id="@+id/property_purpose" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="16dp">
                    <RadioButton android:id="@+id/purpose_sale" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:paddingHorizontal="16dp" android:layout_marginBottom="6dp" android:background="@drawable/choice_card" android:textColor="@color/ink" android:buttonTint="@color/teal" android:text="@string/purpose_sale" android:checked="true" />
                    <RadioButton android:id="@+id/purpose_rent" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:paddingHorizontal="16dp" android:layout_marginBottom="6dp" android:background="@drawable/choice_card" android:textColor="@color/ink" android:buttonTint="@color/teal" android:text="@string/purpose_rent" android:checked="false" />
                </RadioGroup>
                <TextView style="@style/Subtitle" android:text="@string/type_title" />
                <RadioGroup android:id="@+id/property_type" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="16dp">
                    <RadioButton android:id="@+id/type_apartment" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:paddingHorizontal="16dp" android:layout_marginBottom="6dp" android:background="@drawable/choice_card" android:textColor="@color/ink" android:buttonTint="@color/teal" android:text="@string/type_apartment" android:checked="true" />
                    <RadioButton android:id="@+id/type_house" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:paddingHorizontal="16dp" android:layout_marginBottom="6dp" android:background="@drawable/choice_card" android:textColor="@color/ink" android:buttonTint="@color/teal" android:text="@string/type_house" android:checked="false" />
                    <RadioButton android:id="@+id/type_villa" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:paddingHorizontal="16dp" android:layout_marginBottom="6dp" android:background="@drawable/choice_card" android:textColor="@color/ink" android:buttonTint="@color/teal" android:text="@string/type_villa" android:checked="false" />
                </RadioGroup>
                <TextView style="@style/Subtitle" android:text="@string/floors_title" />
                <RadioGroup android:id="@+id/property_floors" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="16dp">
                    <RadioButton android:id="@+id/floor_one" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:paddingHorizontal="16dp" android:layout_marginBottom="6dp" android:background="@drawable/choice_card" android:textColor="@color/ink" android:buttonTint="@color/teal" android:text="@string/floor_one" android:checked="true" />
                    <RadioButton android:id="@+id/floor_two" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:paddingHorizontal="16dp" android:layout_marginBottom="6dp" android:background="@drawable/choice_card" android:textColor="@color/ink" android:buttonTint="@color/teal" android:text="@string/floor_two" android:checked="false" />
                    <RadioButton android:id="@+id/floor_more" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:paddingHorizontal="16dp" android:layout_marginBottom="6dp" android:background="@drawable/choice_card" android:textColor="@color/ink" android:buttonTint="@color/teal" android:text="@string/floor_more" android:checked="false" />
                </RadioGroup>
                <TextView style="@style/Body" android:text="@string/listing_size" android:labelFor="@+id/property_area" />
                <EditText style="@style/Field" android:id="@id/property_area" android:importantForAutofill="no" android:inputType="numberDecimal" android:maxLength="120" android:layout_height="wrap_content" android:minHeight="56dp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/composer_location" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <TextView style="@style/Title" android:text="@string/location_intro" />
                <TextView style="@style/Muted" android:text="@string/location_caption" />
                <com.google.android.material.button.MaterialButton style="@style/Action" android:id="@+id/use_current_location" android:text="@string/location_current" android:layout_height="wrap_content" android:minHeight="56dp" />
                <com.google.android.material.button.MaterialButton style="@style/Secondary" android:id="@+id/choose_map_location" android:text="@string/location_map" android:layout_height="wrap_content" android:minHeight="56dp" />
                <TextView android:id="@+id/location_status" style="@style/Body" android:text="@string/location_none" android:accessibilityLiveRegion="polite" />
                <TextView style="@style/Body" android:text="@string/listing_location" android:labelFor="@+id/property_location" />
                <EditText style="@style/Field" android:id="@id/property_location" android:importantForAutofill="no" android:inputType="textCapSentences" android:maxLength="120" android:layout_height="wrap_content" android:minHeight="56dp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/composer_finish" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <TextView style="@style/Title" android:text="@string/price_play" />
                <TextView style="@style/Muted" android:text="@string/price_hint" />
                <TextView android:id="@+id/price_summary" style="@style/Subtitle" android:textColor="@color/teal" />
                <TextView style="@style/Body" android:text="@string/price_label" android:labelFor="@+id/property_price" />
                <EditText style="@style/Field" android:id="@id/property_price" android:importantForAutofill="no" android:inputType="number" android:maxLength="120" android:layout_height="wrap_content" android:minHeight="56dp" />
                <com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/property_negotiable" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:text="@string/price_negotiable" />
                <TextView style="@style/Subtitle" android:text="@string/photo_story" />
                <TextView style="@style/Muted" android:text="@string/photo_caption" />
                <com.google.android.material.imageview.ShapeableImageView android:id="@+id/listing_photo_preview" android:layout_width="match_parent" android:layout_height="210dp" android:src="@drawable/house_garden" android:scaleType="centerCrop" app:shapeAppearanceOverlay="@style/Photo" android:contentDescription="@string/listing_sample" />
                <com.google.android.material.button.MaterialButton style="@style/Secondary" android:id="@+id/listing_choose_photo" android:text="@string/listing_photo" android:layout_height="wrap_content" android:minHeight="56dp" />
                <TextView style="@style/Muted" android:id="@+id/listing_photo_status" android:text="@string/listing_sample" />
                <TextView style="@style/Body" android:text="@string/listing_description" android:labelFor="@+id/property_description" />
                <EditText style="@style/Field" android:id="@id/property_description" android:importantForAutofill="no" android:inputType="textMultiLine" android:maxLength="2000" android:layout_height="wrap_content" android:minHeight="56dp" android:singleLine="false" android:minLines="3" android:maxLines="6" android:gravity="top|start" />
                <TextView style="@style/Subtitle" android:text="@string/preview_heading" />
                <TextView android:id="@+id/listing_review" style="@style/Body" android:background="@drawable/surface_sage" android:padding="16dp" />
                <TextView style="@style/Muted" android:text="@string/listing_local" />
                <com.google.android.material.button.MaterialButton style="@style/Action" android:id="@+id/listing_submit" android:text="@string/listing_publish" android:layout_height="wrap_content" android:minHeight="56dp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="20dp" android:paddingBottom="8dp" android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton style="@style/Outline" android:id="@+id/composer_previous" android:text="@string/step_previous" android:layout_height="wrap_content" android:minHeight="56dp" android:layout_width="0dp" android:layout_weight="1" android:layout_marginEnd="8dp" />
        <com.google.android.material.button.MaterialButton style="@style/Action" android:id="@+id/composer_next" android:text="@string/step_next" android:layout_height="wrap_content" android:minHeight="56dp" android:layout_width="0dp" android:layout_weight="1" />
    </LinearLayout>
</LinearLayout>