<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/white">
  <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:gravity="center_vertical" android:paddingHorizontal="16dp">
    <TextView android:layout_width="48dp" android:layout_height="48dp" android:text="@string/screen_signup_text_2" android:textSize="32sp" android:gravity="center" android:contentDescription="@string/screen_signup_contentdescription_2" android:onClick="goBack" />
    <TextView style="@style/Subtitle" android:text="@string/screen_signup_text_3" android:gravity="center" android:layout_weight="1" />
    <Space android:layout_width="48dp" android:layout_height="1dp" />
  </LinearLayout>
  <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
      <ImageView android:layout_width="match_parent" android:layout_height="110dp" android:src="@drawable/diar_logo" android:scaleType="fitCenter" android:contentDescription="@string/screen_signup_contentdescription_7" />
      <TextView style="@style/Title" android:text="@string/screen_signup_text_8" />
      <TextView style="@style/Muted" android:text="@string/screen_signup_text_9" />
      <TextView style="@style/Muted" android:text="@string/screen_signup_text_10" />
      <EditText android:id="@+id/full_name" style="@style/Field" android:hint="@string/screen_signup_hint_11" android:inputType="textPersonName" android:autofillHints="textPersonName" />
      <TextView style="@style/Muted" android:text="@string/screen_signup_text_12" />
      <EditText android:id="@+id/signup_phone" style="@style/Field" android:hint="@string/screen_signup_hint_13" android:inputType="phone" android:autofillHints="phone" />
      <TextView style="@style/Muted" android:text="@string/screen_signup_text_14" />
      <EditText android:id="@+id/email" style="@style/Field" android:hint="@string/screen_signup_hint_15" android:inputType="textEmailAddress" android:autofillHints="textEmailAddress" />
      <TextView style="@style/Muted" android:text="@string/screen_signup_text_16" />
      <EditText android:id="@+id/password" style="@style/Field" android:hint="@string/screen_signup_hint_17" android:inputType="textPassword" android:autofillHints="textPassword" />
      <CheckBox android:id="@+id/terms" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/screen_signup_text_18" />
      <com.google.android.material.button.MaterialButton style="@style/Action" android:text="@string/screen_signup_text_19" android:id="@+id/signup_submit" />
      <com.google.android.material.button.MaterialButton style="@style/Action" android:text="@string/screen_signup_text_20" android:tag="login" android:onClick="navigate" />
    </LinearLayout>
  </ScrollView>
</LinearLayout>