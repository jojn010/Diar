<resources>
    <style name="Body">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingExtra">4dp</item>
        <item name="android:layout_marginBottom">12dp</item>
    </style>
    <style name="Title" parent="Body">
        <item name="android:textSize">32sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:lineSpacingExtra">0dp</item>
        <item name="android:layout_marginBottom">16dp</item>
    </style>
    <style name="Subtitle" parent="Body">
        <item name="android:textSize">19sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:layout_marginTop">14dp</item>
    </style>
    <style name="Muted" parent="Body">
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">13sp</item>
    </style>
    <style name="Eyebrow" parent="Body">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/terracotta</item>
        <item name="android:layout_marginBottom">10dp</item>
    </style>
    <style name="Field">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:background">@drawable/field</item>
        <item name="android:padding">16dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textColorHint">@color/muted</item>
        <item name="android:singleLine">true</item>
        <item name="android:layout_marginBottom">18dp</item>
    </style>
    <style name="Action" parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">58dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">18dp</item>
        <item name="backgroundTint">@color/teal</item>
        <item name="rippleColor">#30FFFFFF</item>
        <item name="android:elevation">0dp</item>
    </style>
    <style name="Secondary" parent="Action">
        <item name="backgroundTint">@color/teal_light</item>
        <item name="android:textColor">@color/teal</item>
    </style>
    <style name="Warm" parent="Action">
        <item name="backgroundTint">@color/peach</item>
        <item name="android:textColor">@color/terracotta</item>
    </style>
    <style name="Gold" parent="Action">
        <item name="backgroundTint">@color/gold</item>
        <item name="android:textColor">@color/deep_teal</item>
    </style>
    <style name="Outline" parent="Action">
        <item name="backgroundTint">@color/white</item>
        <item name="android:textColor">@color/ink</item>
        <item name="strokeColor">@color/line</item>
        <item name="strokeWidth">1dp</item>
    </style>
    <style name="TextAction" parent="Action">
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="android:textColor">@color/teal</item>
    </style>
    <style name="Photo" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>
</resources>
